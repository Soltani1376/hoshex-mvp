{
  "version": 2,
  "functions": {
    "api/generate-prompts.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/generate-prompts", "schedule": "30 5 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
